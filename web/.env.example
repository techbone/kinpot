# Relayer: a hot wallet holding a little MON. It pays gas for users and can never move their money.
RELAYER_PRIVATE_KEY=

# Neon Postgres. Leave empty locally to use the embedded database in .data/.
DATABASE_URL=

# Bearer token for POST /api/admin/payees (add or verify payees).
ADMIN_TOKEN=

# Optional private RPCs. The public Monad RPCs are used as a fallback.
NEXT_PUBLIC_RPC_TESTNET=
NEXT_PUBLIC_RPC_MAINNET=

# Development only: show the local anvil network in the switcher.
NEXT_PUBLIC_ENABLE_LOCAL=

# Secret the GitHub Actions keeper sends to /api/keeper (the fallback to Chainlink CRE).
CRON_SECRET=
