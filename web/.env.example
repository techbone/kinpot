# --- Required in production ---

# Relayer wallets: hot wallets holding a little MON each. They pay gas for users and can never move
# anyone's money. Use a separate key per network.
RELAYER_PRIVATE_KEY=            # Monad testnet
RELAYER_PRIVATE_KEY_MAINNET=    # Monad mainnet

# Neon Postgres connection string. Leave empty locally to use the embedded database in .data/.
DATABASE_URL=

# Bearer token for POST /api/admin/payees (add or verify payees).
ADMIN_TOKEN=

# Bearer secret for /api/keeper, the manual fallback to Chainlink CRE.
CRON_SECRET=

# --- Optional ---

# Envio GraphQL endpoint (one indexer serves testnet and mainnet). Without it the app reads the
# chain directly and hides the activity feed. Per-network overrides: NEXT_PUBLIC_ENVIO_TESTNET / _MAINNET.
NEXT_PUBLIC_ENVIO_URL=

# Private RPCs. The public Monad RPCs are used as a fallback.
NEXT_PUBLIC_RPC_TESTNET=
NEXT_PUBLIC_RPC_MAINNET=

# Ramp Network host API key for the "add money" widget.
NEXT_PUBLIC_RAMP_API_KEY=

# Development only: show the local anvil network in the switcher.
NEXT_PUBLIC_ENABLE_LOCAL=
